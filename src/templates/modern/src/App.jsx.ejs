function WhatsAppFloat() {
  const [visible, setVisible] = useState(false)

  useEffect(() => {
    const handleScroll = () => setVisible(window.scrollY > 200)
    window.addEventListener('scroll', handleScroll, { passive: true })
    return () => window.removeEventListener('scroll', handleScroll)
  }, [])

  if (!c.whatsapp) return null

  return (
    <a
      href={`https://wa.me/${c.whatsapp}`}
      target="_blank"
      rel="noopener noreferrer"
      className={`fixed bottom-6 right-6 z-40 flex items-center gap-2 pl-4 pr-5 py-3 rounded-full text-white shadow-lg hover:shadow-xl transition-all duration-300 ${
        visible ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-4 pointer-events-none'
      }`}
      style={{ backgroundColor: '#25D366' }}
      aria-label="Chat on WhatsApp"
    >
      <MessageCircle size={20} />
      <span className="text-sm font-medium hidden sm:inline">Chat on WhatsApp</span>
    </a>
  )
}

function BackToTop() {
  const [visible, setVisible] = useState(false)

  useEffect(() => {
    const handleScroll = () => setVisible(window.scrollY > 400)
    window.addEventListener('scroll', handleScroll, { passive: true })
    return () => window.removeEventListener('scroll', handleScroll)
  }, [])

  return (
    <button
      onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}
      className={`fixed bottom-6 left-6 z-40 p-3 rounded-full bg-white border border-neutral-200 shadow-sm hover:shadow-md text-neutral-600 hover:text-neutral-900 transition-all duration-300 ${
        visible ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-4 pointer-events-none'
      }`}
      aria-label="Back to top"
    >
      <ChevronUp size={18} />
    </button>
  )
}

function ProductDetail() {
  const { id } = useParams()
  const navigate = useNavigate()
  const product = c.catalogue.find((item) => String(item.id) === String(id))

  useEffect(() => {
    document.title = product ? `${product.title} — ${c.name}` : `Product not found — ${c.name}`
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }, [product])

  if (!product) {
    return (
      <section className="pt-32 pb-24 min-h-screen flex items-center justify-center">
        <Container>
          <div className="text-center">
            <div className="w-16 h-16 mx-auto rounded-full bg-neutral-100 flex items-center justify-center mb-5">
              <span className="text-2xl text-neutral-400 font-semibold">?</span>
            </div>
            <h2 className="font-heading text-xl font-semibold text-neutral-900">Product not found</h2>
            <p className="mt-2 text-sm text-neutral-500">
              This product may have been removed or is no longer available.
            </p>
            <button
              onClick={() => navigate('/')}
              className="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-full bg-neutral-900 text-white text-sm font-semibold hover:bg-neutral-800 transition-colors"
            >
              <ChevronLeft size={16} />
              Back to Catalogue
            </button>
          </div>
        </Container>
      </section>
    )
  }

  const related = c.catalogue.filter(
    (item) => item.id !== product.id && item.category === product.category && item.available !== false
  ).slice(0, 4)

  return (
    <section className="pt-28 pb-20 md:pt-32 md:pb-28">
      <Container>
        <button
          onClick={() => navigate('/')}
          className="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-neutral-900 transition-colors mb-8"
        >
          <ChevronLeft size={16} />
          Back to Catalogue
        </button>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
          <Reveal>
            <div className="rounded-3xl overflow-hidden bg-neutral-100">
              <ImageWithFallback
                src={product.image?.src}
                alt={product.title}
                className="w-full aspect-square object-cover"
                initials={product.title?.charAt(0)}
              />
            </div>
          </Reveal>

          <Reveal delay={100}>
            <div className="flex flex-col">
              {product.category && (
                <p className="text-xs font-semibold uppercase tracking-[0.16em] text-neutral-400">
                  {product.category}
                </p>
              )}
              <h1 className="mt-2 font-heading text-3xl md:text-4xl font-bold text-neutral-900 tracking-tight leading-tight">
                {product.title}
              </h1>
              <p className="mt-4 font-heading text-2xl md:text-3xl font-semibold text-primary">
                {c.currency} {Number(product.price).toLocaleString()}
              </p>

              {product.badge && (
                <span className="mt-4 inline-flex self-start items-center px-2.5 py-1 rounded-full bg-neutral-100 text-neutral-700 text-xs font-semibold">
                  {product.badge}
                </span>
              )}

              {product.description && (
                <p className="mt-6 text-neutral-500 leading-relaxed">
                  {product.description}
                </p>
              )}

              {product.specs && product.specs.length > 0 && (
                <div className="mt-8">
                  <h3 className="text-xs font-semibold uppercase tracking-[0.14em] text-neutral-400 mb-3">
                    Specifications
                  </h3>
                  <div className="divide-y divide-neutral-100 border border-neutral-100 rounded-2xl overflow-hidden bg-white">
                    {product.specs.map((spec, i) => (
                      <div key={i} className="flex px-5 py-3.5 text-sm">
                        <span className="w-1/2 text-neutral-500 font-medium">{spec.label || spec.name}</span>
                        <span className="w-1/2 text-neutral-900">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {product.includes && product.includes.length > 0 && (
                <div className="mt-8">
                  <h3 className="text-xs font-semibold uppercase tracking-[0.14em] text-neutral-400 mb-3">
                    What's Included
                  </h3>
                  <ul className="space-y-2">
                    {product.includes.map((item, i) => (
                      <li key={i} className="flex items-start gap-2.5 text-sm text-neutral-600">
                        <span className="mt-2 w-1.5 h-1.5 rounded-full flex-shrink-0 bg-primary" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {c.whatsapp && (
                <div className="mt-auto pt-8">
                  <a
                    href={`https://wa.me/${c.whatsapp}?text=${encodeURIComponent(`Hi, I'm interested in ${product.title} (${c.currency} ${Number(product.price).toLocaleString()})`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full text-white text-sm font-semibold transition-opacity hover:opacity-90"
                    style={{ backgroundColor: '#25D366' }}
                  >
                    <MessageCircle size={20} />
                    Order via WhatsApp
                  </a>
                </div>
              )}
            </div>
          </Reveal>
        </div>
      </Container>
    </section>
  )
}

function RelatedProducts() {
  const { id } = useParams()
  const product = c.catalogue.find((item) => String(item.id) === String(id))
  if (!product) return null

  const related = c.catalogue.filter(
    (item) => item.id !== product.id && item.category === product.category && item.available !== false
  ).slice(0, 4)

  if (related.length === 0) return null

  return (
    <section className="pb-20 md:pb-28">
      <Container>
        <Reveal>
          <h2 className="font-heading text-2xl md:text-3xl font-bold text-neutral-900 tracking-tight mb-8">
            You Might Also Like
          </h2>
        </Reveal>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-x-5 gap-y-10 md:gap-x-7">
          {related.map((item, i) => (
            <ProductCard key={item.id} item={item} index={i} />
          ))}
        </div>
      </Container>
    </section>
  )
}

function HomePage() {
  return (
    <div className="min-h-screen bg-white">
<% if (announcements.length > 0) { %>
      {c.announcements.map((a, i) => (
        <AnnouncementBar key={i} text={a.text} type={a.type} />
      ))}
<% } %>
      <Nav />
      <Hero />
<% if (about) { %>
      <AboutSection />
<% } %>
<% if (catalogue.length > 0) { %>
      <CatalogueSection />
<% } %>
      <Footer />
      <WhatsAppFloat />
      <BackToTop />
    </div>
  )
}

function ProductPage() {
  return (
    <div className="min-h-screen bg-white">
      <Nav />
      <ProductDetail />
      <RelatedProducts />
      <Footer />
      <WhatsAppFloat />
      <BackToTop />
    </div>
  )
}

export default function App() {
  return (
    <Routes>
      <Route path="/" element={<HomePage />} />
      <Route path="/product/:id" element={<ProductPage />} />
    </Routes>
  )
}
