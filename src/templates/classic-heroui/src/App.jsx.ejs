const c = shopConfig

function Container({ children, className = '' }) {
  return (
    <div className={`max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${className}`}>
      {children}
    </div>
  )
}

function Section({ children, bg = '', className = '', id }) {
  return (
    <section id={id} className={`py-16 md:py-24 ${bg} ${className}`}>
      <Container>{children}</Container>
    </section>
  )
}

function ImageWithFallback({ src, alt, className = '', initials }) {
  const [error, setError] = useState(false)
  if (!src || error) {
    return (
      <div
        className={`bg-gradient-to-br from-default-100 to-default-200 flex items-center justify-center ${className}`}
        aria-label={alt || 'Image placeholder'}
      >
        <span className="text-default-400 text-lg font-semibold select-none">
          {initials || (alt ? alt.charAt(0).toUpperCase() : '?')}
        </span>
      </div>
    )
  }
  return (
    <img
      src={src}
      alt={alt || ''}
      className={className}
      loading="lazy"
      onError={() => setError(true)}
    />
  )
}

function AnnouncementBar({ text, type }) {
  const [dismissed, setDismissed] = useState(false)
  if (dismissed || !text) return null

  const colorMap = {
    sale: 'bg-danger-50 text-danger-800 border-danger-200',
    warning: 'bg-warning-50 text-warning-800 border-warning-200',
    info: 'bg-primary-50 text-primary-800 border-primary-200',
    alert: 'bg-secondary-50 text-secondary-800 border-secondary-200',
  }

  return (
    <div className={`${colorMap[type] || colorMap.info} border-b text-sm py-2.5 px-4 text-center relative`}>
      <span className="font-medium">{text}</span>
      <button
        onClick={() => setDismissed(true)}
        className="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-current opacity-50 hover:opacity-100 transition-opacity"
        aria-label="Dismiss announcement"
      >
        <X size={14} />
      </button>
    </div>
  )
}

