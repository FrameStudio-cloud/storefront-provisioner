function CategoryChips({ categories, selected, onChange }) {
  const all = ['All', ...categories]
  return (
    <div className="flex gap-2 overflow-x-auto pb-2 -mx-5 px-5 sm:mx-0 sm:px-0 scrollbar-none">
      {all.map((cat) => {
        const isActive = cat === selected || (!selected && cat === 'All')
        const count = cat === 'All' ? c.catalogue.length : c.catalogue.filter((item) => item.category === cat).length
        return (
          <button
            key={cat}
            onClick={() => onChange(cat === 'All' ? '' : cat)}
            className={`flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium transition-all ${
              isActive
                ? 'bg-neutral-900 text-white'
                : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200'
            }`}
          >
            {cat}
            <span className={`text-xs ${isActive ? 'text-white/60' : 'text-neutral-400'}`}>{count}</span>
          </button>
        )
      })}
    </div>
  )
}

