SUPABASE_URL=https://hmcowpwfefeeossztuem.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
VERCEL_TOKEN=your_vercel_api_token
PORT=3002
# Comma-separated list of dashboard origins allowed to call this API.
# Defaults to https://keel-nu.vercel.app, https://keel.framestudio.co.ke, localhost:5173.
ALLOWED_ORIGINS=
# Deploy rate limiting (per shop).
DEPLOY_RATE_LIMIT=3
DEPLOY_RATE_LIMIT_WINDOW_MS=3600000
# Direct Postgres connection for the pgmq deploy queue (worker + enqueue).
# Use a session/direct connection string (NOT the transaction pooler) so pgmq LISTEN works:
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Optional: Vercel project webhooks so deploy lifecycle events push back to us.
# Must be a public HTTPS URL the internet can reach (e.g. https://provisioner.example.com/webhooks/vercel).
VERCEL_WEBHOOK_URL=
VERCEL_WEBHOOK_SECRET=
# Max attempts per deploy job (worker retries before marking failed).
MAX_DEPLOY_ATTEMPTS=3
