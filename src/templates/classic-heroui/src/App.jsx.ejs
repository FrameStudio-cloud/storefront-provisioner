function SearchBar({ value, onChange, placeholder }) {
  return (
    <Input
      value={value}
      onValueChange={onChange}
      placeholder={placeholder || 'Search products...'}
      startContent={<Search size={18} className="text-default-400" />}
      size="lg"
      radius="lg"
      variant="bordered"
      classNames={{ input: 'text-sm' }}
    />
  )
}

function CategoryChips({ categories, selected, onChange }) {
  const all = ['All', ...categories]

  return (
    <ScrollShadow orientation="horizontal" className="pb-2">
      <div className="flex gap-2">
        {all.map((cat) => {
          const isActive = cat === selected || (!selected && cat === 'All')
          const count = cat === 'All' ? c.catalogue.length : c.catalogue.filter((item) => item.category === cat).length
          return (
            <Chip
              key={cat}
              onClick={() => onChange(cat === 'All' ? '' : cat)}
              color={isActive ? 'primary' : 'default'}
              variant={isActive ? 'solid' : 'flat'}
              className="cursor-pointer flex-shrink-0"
              size="md"
            >
              {cat}
              <span className={`ml-1 ${isActive ? 'text-white/70' : 'text-default-400'}`}>
                ({count})
              </span>
            </Chip>
          )
        })}
      </div>
    </ScrollShadow>
  )
}

